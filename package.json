{
	"name": "@gtrabanco/pi-verboo-provider",
	"version": "0.1.0",
	"description": "Verboo Code model provider for pi - OpenAI-compatible registration with a capability-rich live catalog and per-model thinking-level mapping",
	"keywords": [
		"pi",
		"pi-package",
		"pi-extension",
		"provider",
		"verboo"
	],
	"type": "module",
	"main": "./src/index.ts",
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"files": [
		"src/",
		"scripts/",
		"README.md",
		"LICENSE"
	],
	"scripts": {
		"probe-verboo": "bun run scripts/probe-verboo.ts",
		"generate-catalog": "bun run scripts/generate-catalog.ts",
		"test": "bun test",
		"typecheck": "bunx tsc --noEmit"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": ">=0.87.0 <1",
		"@earendil-works/pi-coding-agent": ">=0.87.0 <1"
	},
	"devDependencies": {
		"@earendil-works/pi-ai": "0.87.1",
		"@earendil-works/pi-coding-agent": "0.87.1",
		"@types/bun": "latest",
		"@types/node": "^24",
		"typescript": "^5"
	},
	"author": "Ivan Cavero <ivan.cavero@solarisdevelopments.com>",
	"license": "MIT"
}
